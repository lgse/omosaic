{
  "schemaVersion": 1,
  "id": "lgse.omosaic",
  "name": "Omosaic",
  "version": "0.1.0",
  "author": "Pierre Berube",
  "license": "MIT",
  "description": "Different walls for every display.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Omosaic.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Omosaic",
    "description": "Choose wallpapers and colors for each display",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right"
  },
  "omarchy": {
    "clonedFrom": "omarchy.background"
  }
}
